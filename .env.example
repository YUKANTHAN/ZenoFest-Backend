# ===== ZenoFest Registration Reorganizer - environment =====

# Path to your Google service account JSON (created in Google Cloud Console).
GOOGLE_SERVICE_ACCOUNT=service_account.json

# OR for deployment platforms that can't serve files:
# Paste the ENTIRE contents of service_account.json here (including braces),
# and it will be written to GOOGLE_SERVICE_ACCOUNT_PATH automatically.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# ID of the RAW responses Google Sheet (the form output).
# This is the long string in the sheet's URL: docs.google.com/spreadsheets/d/<ID>/...
RAW_SHEET_ID=

# Tab name of the raw responses (default from Google Forms).
RAW_TAB_NAME=Form Responses 1

# ID of the ORGANIZED sheet. Leave blank to auto-create + share on first run.
ORGANIZED_SHEET_ID=

# Comma-separated emails to share the organized sheet with (writer rights).
ORGANIZED_SHARE_EMAILS=you@gmail.com

# Shared secret used to authenticate webhooks from Apps Script.
WEBHOOK_TOKEN=change-me-to-a-random-secret

# Port for the local server (Render/Railway override this automatically).
PORT=8080
